// Este arquivo ESPELHA as tabelas que já existem no banco.
// Quem cria/altera as tabelas são as migrations SQL da pasta migrations/ (rodadas à mão no DBeaver).
// Depois de aplicar uma migration, atualize este arquivo e rode `npm run db:generate` na pasta server.
// Nomes no código em camelCase; @map/@@map ligam aos nomes snake_case do banco.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// migrations/001_create_users_and_weekly_schedule.sql
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String
  dayStartHour Int?     @map("day_start_hour") @db.SmallInt
  dayEndHour   Int?     @map("day_end_hour") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  classes Class[]
  events  Event[]
  notes   Note[]
  videos       Video[]
  videoFolders VideoFolder[]

  @@map("users")
}

// migrations/001_create_users_and_weekly_schedule.sql
model Class {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time
  color     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ClassDay[]

  @@index([userId], map: "classes_user_id_idx")
  @@map("classes")
}

// migrations/001_create_users_and_weekly_schedule.sql
model ClassDay {
  classId String @map("class_id") @db.Uuid
  weekday Int    @db.SmallInt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, weekday])
  @@map("class_days")
}

// migrations/002_create_events.sql
model Event {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  eventDate   DateTime  @map("event_date") @db.Date
  startTime   DateTime? @map("start_time") @db.Time
  endTime     DateTime? @map("end_time") @db.Time
  color       String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventDate], map: "events_user_id_event_date_idx")
  @@map("events")
}

// migrations/003_create_notes_and_note_pages.sql
model Note {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String
  paperTheme String   @default("light") @map("paper_theme")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages  NotePage[]
  images NoteImage[]

  @@index([userId], map: "notes_user_id_idx")
  @@map("notes")
}

// migrations/003_create_notes_and_note_pages.sql
model NotePage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  position  Int
  strokes   Json     @default("[]")
  elements  Json     @default("[]") // migrations/004
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, position], map: "note_pages_note_id_position_unique")
  @@map("note_pages")
}

// migrations/004_add_note_page_elements_and_images.sql
model NoteImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId], map: "note_images_note_id_idx")
  @@map("note_images")
}

// migrations/005_create_videos.sql
model Video {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  youtubeId   String   @map("youtube_id")
  title       String
  channelName String?  @map("channel_name")
  folderId    String?  @map("folder_id") @db.Uuid // migrations/006
  notes       String   @default("") // migrations/007
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder VideoFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, youtubeId], map: "videos_user_id_youtube_id_unique")
  @@index([folderId], map: "videos_folder_id_idx")
  @@map("videos")
}

// migrations/006_create_video_folders.sql
// (o índice único de nome, que ignora maiúsculas, existe só no banco: o Prisma não representa lower(name))
model VideoFolder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]

  @@map("video_folders")
}
